generator client {
  provider = "prisma-client-js"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum MeetingState {
  CREATED
  RECORDING
  PROCESSING
  SUMMARY_READY
  COMPLETED
}

enum SummaryMode {
  STANDARD
  IMPORTANT
  DETAILED
}

model Meeting {
  id                  String       @id @default(uuid())
  title               String?
  participantEstimate Int?
  state               MeetingState @default(CREATED)
  startedAt           DateTime?
  endedAt             DateTime?
  durationSeconds     Int?
  totalChunks         Int?
  processedChunks     Int          @default(0)
  transcript          String?      // Whisper transcription output
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  summary             Summary?
}

model Summary {
  id        String      @id @default(uuid())
  meetingId String      @unique
  mode      SummaryMode
  content   String      // JSON string for SQLite compatibility
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  meeting   Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}
